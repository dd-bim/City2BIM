<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
    
  <!-- Fallback für Architektur (wenn $(PlatformTarget) leer ist) -->
  <PropertyGroup>
    <InteropArch>$(PlatformTarget)</InteropArch>
    <InteropArch Condition="'$(InteropArch)' == ''">x64</InteropArch>
  </PropertyGroup>
		
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BIMGISInteropLibs\BIMGISInteropLibs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="FunctionTest.ttinclude">
      <LastGenOutput>FunctionTest.cs</LastGenOutput>
      <Generator>TextTemplatingFileGenerator</Generator>
    </None>
    <None Update="FunctionTestIfc4x3.tt">
      <LastGenOutput>FunctionTestIfc4x3.cs</LastGenOutput>
      <Generator>TextTemplatingFileGenerator</Generator>
    </None>
    <None Update="FunctionTestIfc4.tt">
      <LastGenOutput>FunctionTestIfc4.cs</LastGenOutput>
      <Generator>TextTemplatingFileGenerator</Generator>
    </None>
    <None Update="FunctionTestIfc2x3.tt">
      <LastGenOutput>FunctionTestIfc2x3.cs</LastGenOutput>
      <Generator>TextTemplatingFileGenerator</Generator>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="FunctionTest.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>FunctionTest.ttinclude</DependentUpon>
    </Compile>
    <Compile Update="FunctionTestIfc2x3.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>FunctionTestIfc2x3.tt</DependentUpon>
    </Compile>
    <Compile Update="FunctionTestIfc4.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>FunctionTestIfc4.tt</DependentUpon>
    </Compile>
    <Compile Update="FunctionTestIfc4x3.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>FunctionTestIfc4x3.tt</DependentUpon>
    </Compile>
  </ItemGroup>
	<Target Name="CopyInteropNativeLibraries" AfterTargets="Build">
		<ItemGroup>
			<_InteropNativeFiles Include="..\BIMGISInteropLibs\bin\$(Configuration)\$(TargetFramework)\gdal\$(InteropArch)\*.dll" />
		</ItemGroup>

		<Message Importance="High" Text="Copying Interop native files: @(_InteropNativeFiles) to $(OutputPath)" Condition="'@(_InteropNativeFiles)' != ''" />
		<Message Importance="High" Text="No interop native files found in ..\BIMGISInteropLibs\bin\$(Configuration)\$(TargetFramework)\gdal\$(InteropArch) (check build of Interop project)" Condition="'@(_InteropNativeFiles)' == ''" />

		<Copy SourceFiles="@(_InteropNativeFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" ContinueOnError="false" />
	</Target>
</Project>
