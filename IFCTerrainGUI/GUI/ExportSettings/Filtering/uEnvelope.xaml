<UserControl x:Class="IFCTerrainGUI.GUI.ExportSettings.Envelope.ucEnvelope"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IFCTerrainGUI.GUI.ExportSettings.Envelope"
             mc:Ignorable="d" 
             d:DesignHeight="133.224" d:DesignWidth="418.602">
    <UserControl.Resources>
        <Style x:Key="DefaultTextBoxStyle"
       TargetType="TextBox">
            <Setter Property="VerticalAlignment"
            Value="Center" />
        </Style>
        <Style x:Key="ErrorToolTip"
       TargetType="TextBox"
       BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError"
                 Value="True">
                    <Setter Property="ToolTip"
                    Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="5">
        <StackPanel>
            <DockPanel Margin="0,3" IsEnabled="{Binding customOrigin, Mode=OneWay}">
                <TextBlock Text="Extend-X [m]:"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0"
                    FontSize="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=FontSize}" />

                <TextBox Width="90"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Padding="2"
                    Text="{Binding xExtend, ConverterCulture=de-DE, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource ErrorToolTip}" />

                <TextBlock Text="Extend-Y [m]:"
                    Margin="5,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=FontSize}" />

                <TextBox Width="90"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    VerticalContentAlignment="Center"
                    Padding="2"
                    Text="{Binding yExtend, ConverterCulture=de-DE, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource ErrorToolTip}" />
            </DockPanel>
            <DockPanel Margin="0,3" IsEnabled="{Binding readPoints, Mode=OneWay}">
                <TextBlock Text="Filter Tolerance [m]:"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0"
                    FontSize="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=FontSize}" />

                <TextBox Width="90"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    VerticalContentAlignment="Center"
                    Padding="2"
                    Text="{Binding zFilter, ConverterCulture=de-DE, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource ErrorToolTip}" />
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
