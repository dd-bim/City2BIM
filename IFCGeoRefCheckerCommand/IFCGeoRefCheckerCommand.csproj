    <PackageReference Include="Xbim.IO.MemoryModel" VersionOverride="6.0.445" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="input\" />
    <Folder Include="workingDir\" />
  </ItemGroup>
  <Import Project="..\IFCGeorefShared\IFCGeorefShared.projitems" Label="Shared" />
